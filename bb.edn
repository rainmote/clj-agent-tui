{:tasks
 {:requires ([babashka.process :refer [shell]])
  test {:doc "Run the full test suite."
        :task (shell {:inherit true} "clojure -M:test")}
  lint {:doc "Run clj-kondo."
        :task (shell {:inherit true} "clojure -M:lint")}
  jar {:doc "Build a jar. Optional: VERSION=0.1.0-alpha1 bb jar"
       :task (shell {:inherit true} "clojure -T:build jar")}
  verify {:doc "Run test, lint, public API smoke, cljdoc config validation, and jar build."
          :task (do
                  (shell {:inherit true} "clojure -M:test")
                  (shell {:inherit true} "clojure -M:lint")
                  (shell {:inherit true} "clojure -M -e \"(require '[clj-agent-tui.core :as tui]) (println :ok)\"")
                  (shell {:inherit true} "curl -fsSL https://raw.githubusercontent.com/cljdoc/cljdoc/master/script/verify-cljdoc-edn | bash -s doc/cljdoc.edn")
                  (shell {:inherit true} "clojure -T:build jar"))}
  release {:doc "One-command release: bb release <git-tag> [--dry-run] [--no-push] [--no-deploy]"
           :task (apply shell {:inherit true} "bb" "script/release.clj" *command-line-args*)}}}
